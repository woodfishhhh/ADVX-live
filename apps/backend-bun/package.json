{
  "name": "@advx/backend-bun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./process": "./src/main.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "check:boundaries": "bun run scripts/check-import-boundaries.ts",
    "openapi:check": "bun run src/openapi/snapshot.ts --check",
    "openapi:generate": "bun run src/openapi/snapshot.ts --write",
    "start": "bun run src/main.ts",
    "debug:headless": "bun run src/headless/cli.ts",
    "diagnostics:bundle": "bun run src/diagnostics/cli.ts",
    "profile:cpu": "bun run src/profiling/cli.ts cpu",
    "profile:heap": "bun run src/profiling/cli.ts heap",
    "profile:sample": "bun run src/profiling/cli.ts sample",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:bck-001": "bun test src/index.test.ts src/app.test.ts scripts/check-import-boundaries.test.ts",
    "test:bck-002": "bun test src/infrastructure/config/backend-config.test.ts",
    "test:bck-003": "bun test src/api/system.integration.test.ts",
    "test:bck-004": "bun test src/application/ports/ports.test.ts",
    "test:bck-005": "bun test src/application/services/room-session-lifecycle.test.ts",
    "test:bck-006": "bun test src/application/services/runtime-spec-coordinator.test.ts",
    "test:bck-007": "bun test src/api/control.integration.test.ts",
    "test:bck-008": "bun test src/api/realtime.integration.test.ts",
    "test:bck-009": "bun test src/api/binary-ingest.integration.test.ts",
    "test:bck-010": "bun test src/process-lifecycle.integration.test.ts",
    "test:dat-002": "bun test src/infrastructure/persistence/sqlite/migration-runner.test.ts",
    "test:dat-003": "bun test src/infrastructure/persistence/sqlite/database.test.ts",
    "test:dat-004": "bun test src/infrastructure/persistence/sqlite/repositories.test.ts",
    "test:dat-005": "bun test src/infrastructure/persistence/sqlite/viewer-repository.test.ts",
    "test:dat-006": "bun test src/infrastructure/persistence/sqlite/room-event-repository.test.ts",
    "test:dat-007": "bun test src/infrastructure/persistence/sqlite/room-memory-repository.test.ts",
    "test:dat-008": "bun test src/infrastructure/persistence/sqlite/mode-meme-repository.test.ts",
    "test:dat-009": "bun test src/infrastructure/persistence/sqlite/outbox-repository.test.ts",
    "test:dat-010": "bun test src/infrastructure/persistence/sqlite/legacy-database-migration.test.ts",
    "test:dat-011": "bun test src/infrastructure/persistence/sqlite/persistence-faults.test.ts",
    "test:agt-001": "bun test src/application/ports/providers.test.ts",
    "test:agt-002": "bun test src/providers/asr/stepfun-asr.test.ts",
    "test:agt-003": "bun test src/providers/model/model-gateway.test.ts",
    "test:agt-004": "bun test src/application/services/model-output-validation.test.ts",
    "test:agt-005": "bun test src/application/services/model-request-scheduler.test.ts",
    "test:agt-006": "bun test src/application/services/observation-wave.test.ts",
    "test:agt-007": "bun test src/application/services/session-audience.test.ts",
    "test:agt-008": "bun test src/application/services/viewer-decision-context.test.ts",
    "test:agt-010": "bun test src/application/services/viewer-generation.test.ts",
    "test:agt-009": "bun test src/application/services/viewer-candidate-selection.test.ts",
    "test:agt-011": "bun test src/application/services/barrage-pipeline.test.ts",
    "test:agt-012": "bun test src/application/services/shared-brain-side-effects.test.ts src/application/services/barrage-pipeline.test.ts",
    "test:agt-013": "bun test src/infrastructure/transient-runtime-control.test.ts",
    "test:agt-014": "bun test src/providers/provider-adapters.test.ts",
    "test:obs-007": "bun test src/application/services/replay-service.test.ts src/api/replay.integration.test.ts",
    "test:obs-008": "bun test src/application/evaluation/agent-evaluator.test.ts",
    "test:obs-011": "bun test src/infrastructure/observability/diagnostics-bundle.test.ts",
    "test:obs-012": "bun test --timeout 15000 src/infrastructure/observability/bun-profile-runner.test.ts src/infrastructure/observability/runtime-profile.test.ts",
    "test:tst-003": "bun run typecheck && bun test src/infrastructure/observability/ai-call-evidence-store.test.ts src/api/provider-configuration.integration.test.ts src/api/recorded-pipeline.integration.test.ts src/api/system.integration.test.ts src/api/realtime.integration.test.ts src/application/services/viewer-generation.test.ts",
    "test:tst-004": "bun run typecheck && bun run scripts/run-tst-004.ts",
    "test:tst-004:replay": "bun run scripts/run-tst-004.ts",
    "test:tst-005": "bun run typecheck && bun run scripts/run-tst-005.ts",
    "test:tst-006": "bun run typecheck && bun run scripts/run-tst-006.ts",
    "proof:agt-015": "bun run scripts/agt-015-live-proof.ts"
  },
  "dependencies": {
    "@advx/contracts": "workspace:*",
    "@ai-sdk/openai-compatible": "3.0.17",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "ai": "7.0.42",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29",
    "p-queue": "9.3.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@elysiajs/openapi": "1.4.15",
    "@types/bun": "1.3.14",
    "fast-check": "4.9.0",
    "msw": "2.15.0",
    "typescript": "5.9.3"
  }
}
